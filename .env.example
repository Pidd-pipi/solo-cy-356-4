COMPOSE_PROJECT_NAME=communitygarden

# 端口映射（宿主机端口）
FRONTEND_PORT=28516
BACKEND_PORT=29516
DB_PORT=44001
REDIS_PORT=46301

# 数据库
DB_NAME=communitygarden_db
DB_USER=communitygarden_user
DB_PASSWORD=communitygarden_pwd

# 后端认证
JWT_SECRET=change_me_to_a_long_random_string

# 日志级别
LOG_LEVEL=info

# 地块候补与递补
# 队首确认认养的限定时间（分钟），逾期自动顺延给下一位
WAITLIST_CONFIRM_MINUTES=30
# 后台逾期扫描间隔（秒）
WAITLIST_SWEEP_SECONDS=30
